// Siam University Library — Book Preview
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookStatus {
  AVAILABLE
  BORROWED
}

enum PageType {
  IMAGE
  TEXT
}

enum Role {
  ADMIN
  STAFF
}

/// A physical shelf in the library (A, B, C ...). More can be added later.
model Shelf {
  id        String   @id @default(cuid())
  code      String   @unique // "A"
  nameEn    String
  nameTh    String
  color     String // hex colour, e.g. "#1f4e79"
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id        String        @id @default(cuid())
  code      String        @unique // "A-001" — used in URLs and QR codes
  title     String
  altTitle  String? // title in the other language
  author    String
  category  String
  language  String // "th" | "en"
  year      Int?
  publisher String?
  isbn      String?
  shelfId   String
  shelf     Shelf         @relation(fields: [shelfId], references: [id])
  row       Int
  status    BookStatus    @default(AVAILABLE)
  dueDate   DateTime?
  pages     PreviewPage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([shelfId])
  @@index([status])
  @@index([category])
}

/// One page of the preview: a staff photo (IMAGE) or typed text (TEXT).
model PreviewPage {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int
  type      PageType
  imagePath String? // file name inside UPLOAD_DIR (random UUID .webp)
  text      String?
  createdAt DateTime @default(now())

  @@index([bookId, order])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Two-step login (TOTP, src/lib/totp.ts). Secrets are stored AES-256-GCM encrypted.
  totpSecret        String? // active secret, set when 2FA is turned on
  totpPendingSecret String? // secret shown on the setup page, until the first code confirms it
  totpEnabledAt     DateTime?
  totpLastStep      Int? // last accepted 30-second step — a code can be used only once
  backupCodes       BackupCode[]
}

/// One-time backup codes for two-step login (SHA-256 hashes, never the codes themselves).
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
}

/// Failed-login counters for the rate limiter (one row per key, fixed window).
/// Kept in the database so the limit holds across serverless instances (Vercel).
model LoginThrottle {
  key     String   @id // "login:acct:<email>", "login:ip:<ip>", ...
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
