# Copy this file to .env and change every value marked CHANGE-ME.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev (npm run db:start) uses port 5433:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siam_library"
# Vercel + Neon only (set automatically by the Neon integration): DATABASE_URL is the POOLED
# connection used by the app; this DIRECT one is used by Prisma CLI (migrate deploy).
# Leave unset locally / in Docker — prisma.config.ts then falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# docker-compose builds its own DATABASE_URL from these:
POSTGRES_USER="library"
POSTGRES_PASSWORD="CHANGE-ME-strong-db-password"
POSTGRES_DB="siam_library"

# --- Auth.js ----------------------------------------------------------------
# Generate with:  npx auth secret   (or any 32+ random characters)
AUTH_SECRET="CHANGE-ME-32-plus-random-characters"
# Needed when running behind a reverse proxy / Docker:
AUTH_TRUST_HOST="true"

# --- Staff area ---------------------------------------------------------------
# SECRET path of the staff area (there is no /admin). Lowercase letters, digits and dashes,
# at least 16 characters after the slash. Generate one with:
#   node -e "console.log('/staff-' + require('crypto').randomBytes(16).toString('hex'))"
# Unset or invalid → the staff area is switched off (every staff URL is a 404).
ADMIN_PATH="/staff-CHANGE-ME-to-a-long-random-value"

# --- Site -------------------------------------------------------------------
# Public address used inside QR codes. Set to the real server URL before printing stickers.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Who can read book previews: "public" (anyone) or "students" (logged-in only, future).
PREVIEW_ACCESS="public"

# Where uploaded preview photos are stored (outside /public) when Vercel Blob is NOT used.
UPLOAD_DIR="./uploads"
# Vercel only (set automatically when the Blob store is connected): store photos in a PRIVATE
# Vercel Blob store instead of UPLOAD_DIR. Leave unset locally / in Docker.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Demo seed accounts (only used by `npm run db:seed`) ----------------------
SEED_ADMIN_EMAIL="admin@library.siam.edu"
SEED_ADMIN_PASSWORD="CHANGE-ME-admin-password"
SEED_STAFF_EMAIL="staff@library.siam.edu"
SEED_STAFF_PASSWORD="CHANGE-ME-staff-password"
# LOCAL / TEST ONLY: base32 two-step-login secret for the demo admin, so Playwright can make
# codes. Leave unset on any real server (the admin then sets up 2FA on first login).
# SEED_ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"
